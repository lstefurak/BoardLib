# Copy to .env and fill in to run the live Tension integration tests.
# .env is gitignored and must never be committed.
TENSION_USERNAME=your_tension_username
TENSION_PASSWORD=your_tension_password

# Optional: override the board under test (defaults to "tension").
# TENSION_BOARD=tension

# --- Local UI dev (scripts/serve_local.py) ---
# The gate phrase ("knock"). Pre-filled on the gate page when serving locally,
# so you only press Enter to get through.
BOARDLOG_KNOCK=
# Optional Function URL to call from localhost. Leave blank to run backend-free
# (gate opens locally, load a CSV to test). A production URL will CORS-fail from
# localhost -- that is expected.
BOARDLOG_ENDPOINT=
